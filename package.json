{
  "name": "akshara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first desktop PDF reader with optional metadata sync.",
  "author": "Peritooo <peritooo@users.noreply.github.com>",
  "main": "electron/main.bundle.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:main",
    "build:main": "esbuild electron/main.cjs --bundle --platform=node --target=node22 --external:electron --format=cjs --outfile=electron/main.bundle.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "app:start": "npm run build && electron .",
    "app:dir": "npm run build && electron-builder --linux --dir",
    "app:dist": "npm run build && electron-builder --linux --publish never",
    "app:dist:win": "npm run build && electron-builder --win --publish never",
    "app:dist:mac": "npm run build && electron-builder --mac --publish never",
    "test:e2e": "npm run build:main && node --test tests/electron.test.mjs",
    "test": "npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "epubjs": "^0.3.93",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peritoooo/akshara.git"
  },
  "bugs": {
    "url": "https://github.com/Peritoooo/akshara/issues"
  },
  "homepage": "https://github.com/Peritoooo/akshara#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pdf",
    "reader",
    "electron",
    "react",
    "supabase",
    "local-first",
    "highlights"
  ]
}
